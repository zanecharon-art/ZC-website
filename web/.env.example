# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — server-only, used by the Stripe webhook to bypass RLS.
# Never expose this with the NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Contact form delivery via Web3Forms (https://web3forms.com — enter your email,
# get an access key by return mail, no account needed). Read server-side at
# request time by /api/contact, so it takes effect on redeploy without a
# rebuild and is never exposed to the browser. Without this the contact page
# still shows the email address; the form just points visitors to it.
# (A legacy NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY is also still accepted.)
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Community moderation: the account with this email sees the moderation area
# and can lock/remove threads and posts. Set it to your own login email.
NEXT_PUBLIC_ADMIN_EMAIL=you@example.com
